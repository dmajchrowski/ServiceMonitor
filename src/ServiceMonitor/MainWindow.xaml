<Window x:Class="ServiceMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ServiceMonitor.ViewModels"
        xmlns:views="clr-namespace:ServiceMonitor.Views"
        Title="Service Monitor"
        Icon="Assets/app.ico"
        Width="1200" Height="800" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}"><views:OverviewView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ServicesViewModel}"><views:ServicesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ChannelsViewModel}"><views:ChannelsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ActivityViewModel}"><views:ActivityView /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Navigation -->
        <DockPanel Grid.Column="0" Margin="12,14,10,12">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,2,0,22">
                <Image Source="Assets/app-256.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Service Monitor" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="{Binding MachineName}" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="14,12" DataContext="{Binding Overview}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource HealthDot}" />
                        <TextBlock Margin="8,0,0,0" FontWeight="SemiBold" Text="{Binding DataContext.MonitorStateText, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Help}" Text="{Binding DataContext.Version, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=Version {0}}" />
                </StackPanel>
            </Border>

            <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" ItemContainerStyle="{StaticResource NavItem}"
                     Background="Transparent" BorderThickness="0" Padding="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" />
                            <TextBlock Margin="14,0,0,0" Text="{Binding Title}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Page, with the latest message in a bar below it. The bar takes its own space instead of floating over the
             page, where it covered whatever was at the bottom (e.g. the Export / Import buttons it was reporting on). -->
        <Border Grid.Column="1" Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
            <DockPanel>
                <Border DockPanel.Dock="Bottom" Margin="36,0,36,16" Visibility="{Binding Toast, Converter={StaticResource NullToVisibility}}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource InfoBar}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ToastLevel}" Value="Success">
                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ToastLevel}" Value="Error">
                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ToastLevel}" Value="Warning">
                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Margin="16,0,0,0" Padding="6,2" Command="{Binding DismissToastCommand}" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0" ToolTip="Dismiss" AutomationProperties.Name="Dismiss message">
                            <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE711;" />
                        </Button>
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="16">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                    <Setter Property="Text" Value="&#xE946;" />
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorAttentionBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ToastLevel}" Value="Success">
                                            <Setter Property="Text" Value="&#xE930;" />
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ToastLevel}" Value="Error">
                                            <Setter Property="Text" Value="&#xEA39;" />
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ToastLevel}" Value="Warning">
                                            <Setter Property="Text" Value="&#xE7BA;" />
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Toast}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <ContentControl Content="{Binding SelectedPage}" Focusable="False" />
            </DockPanel>
        </Border>

        <!-- Unsaved changes bar -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Padding="24,12" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Discard" Command="{Binding DiscardCommand}" MinWidth="96" />
                    <Button Content="Save changes" Command="{Binding SaveCommand}" Style="{StaticResource AccentButtonStyle}" MinWidth="120" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                    <TextBlock Margin="10,0,0,0" Text="You have unsaved changes. The monitor keeps using the previous settings until you save." VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Busy overlay -->
        <Grid Grid.RowSpan="2" Grid.ColumnSpan="2" Background="#66000000" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource Card}" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="32,24" MinWidth="380">
                <StackPanel>
                    <TextBlock Text="{Binding BusyText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <ProgressBar IsIndeterminate="True" Margin="0,16,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
