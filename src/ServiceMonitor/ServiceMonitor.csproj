<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>ServiceMonitor</RootNamespace>
    <AssemblyName>ServiceMonitor</AssemblyName>
    <StartupObject>ServiceMonitor.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>Service Monitor</Product>
    <Description>Sends email, chat and push notifications when Windows services stop, crash or hang.</Description>
    <!-- WPF's Fluent theme (ThemeMode) is still flagged experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <!-- One self-contained exe: nothing to install on customer machines (no .NET runtime needed). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- OAuth app registrations baked in at publish time (see build\publish.ps1 and docs\OAUTH-APP-REGISTRATION.md). -->
  <ItemGroup>
    <AssemblyMetadata Include="MicrosoftClientId" Value="$(MicrosoftClientId)" />
    <AssemblyMetadata Include="MicrosoftTenant" Value="$(MicrosoftTenant)" />
    <AssemblyMetadata Include="GoogleClientId" Value="$(GoogleClientId)" />
    <AssemblyMetadata Include="GoogleClientSecret" Value="$(GoogleClientSecret)" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app-256.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.EventLog" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ServiceMonitor.Core\ServiceMonitor.Core.csproj" />
  </ItemGroup>

</Project>
