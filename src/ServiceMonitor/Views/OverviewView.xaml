<UserControl x:Class="ServiceMonitor.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="140" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Step row in the getting-started checklist; Tag = done flag -->
        <Style x:Key="StepIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="Text" Value="&#xEA3A;" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Style.Triggers>
                <!-- DataTrigger (not Trigger) so the bool in Tag is compared as a bool -->
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Text" Value="&#xEC61;" />
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,30,36,36" MaxWidth="1080">
            <TextBlock Style="{StaticResource PageTitle}" Text="Overview" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="{Binding Main.MachineName, StringFormat=Watches selected Windows services on {0} and notifies you when they stop\, crash or hang.}" />

            <!-- Maintenance mode banner -->
            <Border Style="{StaticResource InfoBarWarning}" Margin="0,0,0,16" Visibility="{Binding PausedText, Converter={StaticResource NullToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Resume alerts now" Command="{Binding ResumeAlertsCommand}" Margin="16,0,0,0" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE769;" />
                        <TextBlock Margin="10,0,0,0" Text="{Binding PausedText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Monitor status -->
            <Border Style="{StaticResource Card}" Padding="24,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Width="52" Height="52" CornerRadius="26" VerticalAlignment="Top">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource ControlStrongFillColorDisabledBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Health}" Value="Ok"><Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Health}" Value="Problem"><Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Health}" Value="Warning"><Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Health}" Value="Pending"><Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBrush}" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock HorizontalAlignment="Center" FontSize="24" Foreground="White">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                    <Setter Property="Text" Value="&#xE9D9;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Health}" Value="Ok"><Setter Property="Text" Value="&#xE73E;" /></DataTrigger>
                                        <DataTrigger Binding="{Binding Health}" Value="Problem"><Setter Property="Text" Value="&#xE7BA;" /></DataTrigger>
                                        <DataTrigger Binding="{Binding Health}" Value="Warning"><Setter Property="Text" Value="&#xE7BA;" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="20,0,0,0">
                        <TextBlock Text="{Binding HeroTitle}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding HeroText}" Style="{StaticResource Help}" FontSize="13" Margin="0,6,0,0" />
                    </StackPanel>
                    <WrapPanel Grid.Row="1" Grid.Column="1" Margin="20,18,0,0">
                        <Button Command="{Binding InstallCommand}" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0"
                                Visibility="{Binding ShowInstall, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="14" />
                                <TextBlock Margin="8,0,0,0" Text="Install &amp; start monitoring" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding StartMonitorCommand}" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0"
                                Visibility="{Binding ShowStart, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="14" />
                                <TextBlock Margin="8,0,0,0" Text="Start monitoring" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding InstallCommand}" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0"
                                ToolTip="The installed monitor is a different version than this program. Click to replace it with this version."
                                Visibility="{Binding ShowUpdateButton, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="14" />
                                <TextBlock Margin="8,0,0,0" Text="Update installed monitor" />
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding ShowRunningActions, Converter={StaticResource BoolToVisibility}}">
                            <Button x:Name="PauseButton" Margin="0,0,8,0" Click="PauseButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE769;" FontSize="14" />
                                    <TextBlock Margin="8,0,0,0" Text="Pause alerts" />
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="10" Margin="8,0,0,0" />
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="For 30 minutes" Command="{Binding PauseAlertsCommand}" CommandParameter="30" />
                                        <MenuItem Header="For 1 hour" Command="{Binding PauseAlertsCommand}" CommandParameter="60" />
                                        <MenuItem Header="For 4 hours" Command="{Binding PauseAlertsCommand}" CommandParameter="240" />
                                        <MenuItem Header="Until tomorrow 8:00" Command="{Binding PauseAlertsCommand}" CommandParameter="tomorrow" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button Command="{Binding RestartMonitorCommand}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="14" />
                                    <TextBlock Margin="8,0,0,0" Text="Restart monitor" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding StopMonitorCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" FontSize="14" />
                                    <TextBlock Margin="8,0,0,0" Text="Stop" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Getting started -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding AllStepsDone, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Set up in four steps" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource StepIcon}" Tag="{Binding StepServicesDone}" Margin="0,8" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="14,8" VerticalAlignment="Center">
                            <TextBlock Text="Choose the services to watch" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Help}" Text="Any Windows service – for example every service whose name contains a vendor's name." />
                        </StackPanel>
                        <Button Grid.Row="0" Grid.Column="2" Content="Choose services" Command="{Binding GoToServicesCommand}" Style="{StaticResource StepButton}" />

                        <TextBlock Grid.Row="1" Style="{StaticResource StepIcon}" Tag="{Binding StepChannelsDone}" Margin="0,8" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="14,8" VerticalAlignment="Center">
                            <TextBlock Text="Choose where alerts go" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Help}" Text="Gmail, Yahoo, iCloud, any SMTP server, phone push, Teams, Slack, Discord, Telegram or a webhook." />
                        </StackPanel>
                        <Button Grid.Row="1" Grid.Column="2" Content="Add a channel" Command="{Binding GoToChannelsCommand}" Style="{StaticResource StepButton}" />

                        <TextBlock Grid.Row="2" Style="{StaticResource StepIcon}" Tag="{Binding StepTestDone}" Margin="0,8" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="14,8" VerticalAlignment="Center">
                            <TextBlock Text="Send a test notification" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Help}" Text="Confirms the sign-in works and the message arrives." />
                        </StackPanel>
                        <Button Grid.Row="2" Grid.Column="2" Content="Send test" Command="{Binding SendTestToAllCommand}" Style="{StaticResource StepButton}" />

                        <TextBlock Grid.Row="3" Style="{StaticResource StepIcon}" Tag="{Binding StepMonitorDone}" Margin="0,8" />
                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="14,8" VerticalAlignment="Center">
                            <TextBlock Text="Start background monitoring" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Help}" Text="Installs a small Windows service that keeps watching after you sign out and after reboots." />
                        </StackPanel>
                        <Button Grid.Row="3" Grid.Column="2" Content="Install &amp; start" Command="{Binding InstallCommand}" Style="{StaticResource StepButton}"
                                Visibility="{Binding ShowInstall, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Services -->
            <DockPanel Margin="0,28,0,10">
                <Button DockPanel.Dock="Right" Content="Choose services" Command="{Binding GoToServicesCommand}" />
                <TextBlock Style="{StaticResource SectionHeader}" Text="Monitored services" VerticalAlignment="Center" Margin="0" />
            </DockPanel>
            <Border Style="{StaticResource Card}" Visibility="{Binding Cards.Count, Converter={StaticResource EmptyToVisibility}}">
                <TextBlock Style="{StaticResource Help}" FontSize="13" Margin="0"
                           Text="No services selected yet. Click Choose services and tick the ones to watch." />
            </Border>
            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="330" Margin="0,0,12,12" Padding="16,14">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding State}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    <Ellipse Style="{StaticResource HealthDot}" />
                                    <TextBlock Margin="10,0,0,0" Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ServiceName}" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Help}" Text="{Binding Detail}" Margin="20,6,0,0" MinHeight="18" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Test -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="Test notifications" Margin="0,18,0,10" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding SendTestToAllCommand}" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center"
                                IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBool}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE724;" FontSize="14" />
                                <TextBlock Margin="8,0,0,0" Text="Send test to all channels" />
                            </StackPanel>
                        </Button>
                        <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"
                                   Text="Sends a short test message through every enabled channel so you can confirm alerts arrive." />
                    </DockPanel>
                    <ProgressBar IsIndeterminate="True" Margin="0,14,0,0" Visibility="{Binding IsTesting, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding TestResults}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,1,10,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                <Setter Property="Text" Value="&#xEB90;" />
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Success}" Value="True">
                                                        <Setter Property="Text" Value="&#xEC61;" />
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="{Binding Channel, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Message, Mode=OneWay}" />
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
