<Window x:Class="ServiceMonitor.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Service Monitor" Icon="/Assets/app.ico"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="Heading" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" />
        <TextBlock x:Name="Message" Style="{StaticResource Help}" FontSize="13" Margin="0,8,0,0" />
        <TextBlock Style="{StaticResource FieldLabel}" Text="Password" />
        <PasswordBox x:Name="First" AutomationProperties.Name="Password" />
        <StackPanel x:Name="ConfirmPanel">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Type it again" />
            <PasswordBox x:Name="Second" AutomationProperties.Name="Type it again" />
        </StackPanel>
        <Border x:Name="ErrorBar" Style="{StaticResource InfoBarError}" Margin="0,14,0,0" Visibility="Collapsed">
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" />
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="Ok" IsDefault="True" Style="{StaticResource AccentButtonStyle}" MinWidth="100" Click="OnOk" />
            <Button Content="Cancel" IsCancel="True" MinWidth="100" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
