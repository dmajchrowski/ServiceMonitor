<UserControl x:Class="ServiceMonitor.Views.ServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ServiceMonitor.UI">
    <Grid Margin="36,30,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource PageTitle}" Text="Services" />
        <TextBlock Grid.Row="1" Style="{StaticResource PageSubtitle}"
                   Text="Tick every service you want to be told about. You'll get an alert when it stops, crashes, hangs while starting or stopping, or – with a port check – stops answering." />

        <!-- Toolbar -->
        <DockPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding MonitoredCount, StringFormat={}{0} monitored}" />
            <TextBox Width="320" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ui:Placeholder.Text="Search by name or description" VerticalContentAlignment="Center" />
            <Button Margin="8,0,0,0" Command="{Binding MonitorAllMatchesCommand}" Style="{StaticResource AccentButtonStyle}"
                    Visibility="{Binding CanMonitorAllMatches, Converter={StaticResource BoolToVisibility}}"
                    Content="{Binding MonitorAllText}" />
            <CheckBox Margin="16,0,0,0" Content="Show monitored only" IsChecked="{Binding ShowMonitoredOnly}" VerticalAlignment="Center" />
            <Button Margin="16,0,0,0" Command="{Binding RefreshCommand}" ToolTip="Reload the list of services" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="14" />
                    <TextBlock Margin="8,0,0,0" Text="Refresh" />
                </StackPanel>
            </Button>
        </DockPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- Service list -->
            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <DataGrid ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single"
                              Background="Transparent" BorderThickness="0" RowHeight="40" EnableRowVirtualization="True">
                        <DataGrid.Resources>
                            <!-- Softer selection than the default solid accent fill, which is hard to read on light accent colors -->
                            <SolidColorBrush x:Key="DataGridRowSelectedBackgroundThemeBrush" Color="{DynamicResource SubtleFillColorSecondary}" />
                            <SolidColorBrush x:Key="DataGridRowSelectedForegroundThemeBrush" Color="{DynamicResource TextFillColorPrimary}" />
                            <Style x:Key="CellText" TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="Margin" Value="0,0,8,0" />
                                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource DefaultDataGridRowStyle}">
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource DefaultDataGridCellStyle}">
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Monitor" Width="80" SortMemberPath="IsMonitored">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsMonitored, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" MinWidth="0" Padding="0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Name" Binding="{Binding DisplayName, Mode=OneWay}" Width="2*" IsReadOnly="True" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Service name" Binding="{Binding ServiceName, Mode=OneWay}" Width="*" MinWidth="125" IsReadOnly="True" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Status" Binding="{Binding State, Mode=OneWay}" Width="90" IsReadOnly="True" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Startup" Binding="{Binding StartType, Mode=OneWay}" Width="100" IsReadOnly="True" ElementStyle="{StaticResource CellText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Style="{StaticResource Help}" FontSize="13" Margin="20,60,20,0" HorizontalAlignment="Center" TextAlignment="Center"
                               Visibility="{Binding MatchCount, Converter={StaticResource EmptyToVisibility}}"
                               Text="No services match. Check the spelling, or clear the search box." />
                    <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>

            <!-- Options for the selected service -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="16,0,0,0" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20,18">
                        <TextBlock Style="{StaticResource Help}" FontSize="13" Text="Select a service to see its options."
                                   Visibility="{Binding Selected, Converter={StaticResource NullToCollapsedInverse}}" />
                        <StackPanel DataContext="{Binding Selected}"
                                    Visibility="{Binding DataContext.Selected, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullToVisibility}}">
                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Help}">
                                <Run Text="{Binding ServiceName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding State, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding StartType, Mode=OneWay}" />
                            </TextBlock>

                            <CheckBox Margin="0,16,0,0" IsChecked="{Binding IsMonitored}" Content="Monitor this service" FontWeight="SemiBold" />

                            <StackPanel Visibility="{Binding IsMonitored, Converter={StaticResource BoolToVisibility}}">
                                <Separator Margin="0,16,0,4" />

                                <CheckBox Margin="0,12,0,0" IsChecked="{Binding AutoRestart}" Content="Restart it automatically" />
                                <TextBlock Style="{StaticResource Help}" Margin="28,2,0,0"
                                           Text="When the service stops or crashes the monitor tries to start it again (delay and number of attempts are under Settings). You're notified either way." />

                                <TextBlock Style="{StaticResource FieldLabel}" Text="Report as hung after (seconds)" Margin="0,18,0,6" />
                                <TextBox Width="120" HorizontalAlignment="Left" Text="{Binding HangThresholdText, UpdateSourceTrigger=PropertyChanged}"
                                         ui:Placeholder.Text="Default" />
                                <TextBlock Style="{StaticResource Help}"
                                           Text="How long the service may stay in Starting or Stopping before it counts as hung. Leave empty to use the default from Settings." />

                                <CheckBox Margin="0,20,0,0" IsChecked="{Binding PortCheckEnabled}" Content="Also check that it answers on a TCP port" />
                                <TextBlock Style="{StaticResource Help}" Margin="28,2,0,0"
                                           Text="Catches a service that Windows still shows as Running but that has frozen. Alerts after 3 failed checks in a row." />
                                <StackPanel Margin="28,10,0,0" Visibility="{Binding PortCheckEnabled, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel>
                                            <TextBlock Text="Host" Margin="0,0,0,4" />
                                            <TextBox Width="140" Text="{Binding PortHost, UpdateSourceTrigger=LostFocus}" />
                                        </StackPanel>
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="Port" Margin="0,0,0,4" />
                                            <TextBox Width="80" Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <Button Margin="8,0,0,0" VerticalAlignment="Bottom" Content="Detect" Command="{Binding DetectPortsCommand}"
                                                ToolTip="Find the ports this service is listening on" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Help}" Text="{Binding DetectMessage}"
                                               Visibility="{Binding DetectMessage, Converter={StaticResource NullToVisibility}}" Margin="0,8,0,0" />
                                    <ItemsControl ItemsSource="{Binding DetectedPorts}" Margin="0,6,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Margin="0,0,6,6" Padding="8,3"
                                                        Command="{Binding DataContext.UsePortCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock><Run Text="{Binding Address, Mode=OneWay}" /><Run Text=":" /><Run Text="{Binding Port, Mode=OneWay}" /></TextBlock>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
